<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.clawd.morning-show</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/clawd/clawd-harness/projects/clawd-morning-show/scripts/cron.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/clawd</string>
		<key>PATH</key>
		<string>/Users/clawd/.local/bin:/opt/homebrew/opt/ffmpeg-full/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/clawd/clawd-harness/projects/clawd-morning-show</string>
	<key>StandardOutPath</key>
	<string>/Users/clawd/clawd-harness/projects/clawd-morning-show/out/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/clawd/clawd-harness/projects/clawd-morning-show/out/launchd.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>45</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
